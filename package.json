{
  "name": "crate-app",
  "version": "2.8.0-qa.5",
  "productName": "Crate",
  "description": "Universal project file packager for graphic designers — macOS desktop app",
  "main": "main.js",
  "scripts": {
    "start": "electron ."
  },
  "dependencies": {
    "ag-psd": "^30.1.0",
    "canvas": "^3.2.1",
    "chokidar": "^3.6.0",
    "electron-store": "^8.2.0",
    "node-fetch": "^2.7.0",
    "pako": "^2.1.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "appdmg": "^0.6.6",
    "electron": "^39.8.10",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.crate.app",
    "afterSign": "scripts/notarize.js",
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "identity": "Bryant Feintuch (YY7WDMUFWJ)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.plist",
      "entitlementsInherit": "entitlements.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Install Crate",
      "background": "build/dmg-background.png",
      "window": {
        "width": 540,
        "height": 380
      },
      "iconSize": 120,
      "contents": [
        {
          "x": 135,
          "y": 180,
          "type": "file"
        },
        {
          "x": 405,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
