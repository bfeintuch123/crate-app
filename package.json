{
  "name": "crate-app",
  "version": "3.0.0-beta.2.7",
  "productName": "Crate",
  "description": "Universal project file packager for graphic designers — macOS desktop app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test:app-contents": "node --test tests/app-content-policy.test.js",
    "verify:app-contents": "node scripts/verify-app-contents.js"
  },
  "dependencies": {
    "ag-psd": "^30.1.0",
    "canvas": "^3.2.1",
    "chokidar": "^3.6.0",
    "electron-store": "^8.2.0",
    "node-fetch": "^2.7.0",
    "pako": "^2.1.0"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "appdmg": "^0.6.6",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.7"
  },
  "overrides": {
    "@electron/universal": "3.0.6",
    "brace-expansion": "5.0.8",
    "ejs": "6.0.1",
    "minimatch": "10.2.6"
  },
  "build": {
    "appId": "com.crate.app",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": true
    },
    "files": [
      "main.js",
      "preload.js",
      "provenance.js",
      "diagnostic-summary.js",
      "renderer/**/*",
      "parsers/*.js",
      "assets/tray-icon.png"
    ],
    "afterPack": "scripts/patch-helper-info-plists.js",
    "afterSign": "scripts/notarize.js",
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "identity": "Bryant Feintuch (YY7WDMUFWJ)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.plist",
      "entitlementsInherit": "entitlements.inherit.plist",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Crate uses Automation to read open design documents and linked assets from apps like Adobe Illustrator while you are actively watching a project.",
        "NSAudioCaptureUsageDescription": null,
        "NSBluetoothAlwaysUsageDescription": null,
        "NSBluetoothPeripheralUsageDescription": null,
        "NSCameraUsageDescription": null,
        "NSMicrophoneUsageDescription": null,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "sign": true,
      "title": "Install Crate",
      "background": "build/dmg-background.png",
      "window": {
        "width": 540,
        "height": 380
      },
      "iconSize": 120,
      "contents": [
        {
          "x": 135,
          "y": 180,
          "type": "file"
        },
        {
          "x": 405,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
