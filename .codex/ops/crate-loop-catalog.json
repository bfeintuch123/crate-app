{
  "schema_version": 1,
  "loops": [
    {
      "id": "failure-loop",
      "owner": "crate-failure-loop",
      "playbook": ".codex/playbooks/crate-codex-loops.md",
      "standing_order": "SO-002",
      "modes": ["triage", "fix", "verify", "handoff"],
      "stop_gates": ["approval required before code mutation unless the active mode already authorizes it", "stop before release or deploy"],
      "evidence_outputs": ["bug classification", "focused test results", "PR or handoff"]
    },
    {
      "id": "pr-review-loop",
      "owner": "crate-pr-review",
      "playbook": ".codex/playbooks/review-crate-pr.md",
      "standing_order": "SO-002",
      "modes": ["review-only", "merge-readiness"],
      "stop_gates": ["do not merge without Bryant approval", "base must match the canonical branch"],
      "evidence_outputs": ["findings", "checks", "merge recommendation"]
    },
    {
      "id": "release-loop",
      "owner": "crate-release-gate",
      "playbook": ".codex/playbooks/crate-release-gate.md",
      "standing_order": "SO-003",
      "modes": ["read-only gate", "approved release execution"],
      "stop_gates": ["explicit version and release approval required", "site deploy requires separate approval"],
      "evidence_outputs": ["release proof bundle", "artifact metadata", "QA prompt"]
    },
    {
      "id": "site-deploy-loop",
      "owner": "crate-cloudflare-deploy",
      "playbook": ".codex/playbooks/crate-cloudflare-deploy.md",
      "standing_order": "SO-004",
      "modes": ["preflight", "approved deploy", "post-deploy check"],
      "stop_gates": ["target must be get-crate", "never print the Cloudflare token"],
      "evidence_outputs": ["deployment URL", "live-site verification"]
    },
    {
      "id": "tester-feedback-loop",
      "owner": "crate-tester-intake",
      "playbook": ".codex/playbooks/crate-tester-intake.md",
      "standing_order": "SO-005",
      "modes": ["intake", "normalize", "triage"],
      "stop_gates": ["do not expose private tester assets", "code fixes require failure-loop routing"],
      "evidence_outputs": ["privacy-safe feedback record", "severity", "next route"]
    },
    {
      "id": "thread-coordination-loop",
      "owner": "crate-thread-chief",
      "playbook": ".codex/playbooks/crate-external-control-layer.md",
      "standing_order": "SO-006",
      "modes": ["thread", "subagent", "handoff"],
      "stop_gates": ["one builder edits app code at a time", "do not delegate secrets or release mutation"],
      "evidence_outputs": ["thread or agent ID", "integrated result", "state update"]
    },
    {
      "id": "ops-improvement-loop",
      "owner": "crate-skill-workshop",
      "playbook": ".codex/playbooks/crate-codex-loops.md",
      "standing_order": "SO-007",
      "modes": ["research", "proposal", "prototype", "review"],
      "stop_gates": ["external research is not proof", "do not install or merge without approval"],
      "evidence_outputs": ["duplication assessment", "validation", "PR state"]
    },
    {
      "id": "design-review-loop",
      "owner": "crate-design-review",
      "playbook": ".codex/playbooks/crate-codex-loops.md",
      "standing_order": "SO-008",
      "modes": ["evidence", "critique", "implementation-brief"],
      "stop_gates": ["do not mutate Figma or code without separate approval", "generated concepts are not approved specifications"],
      "evidence_outputs": ["workflow-specific findings", "visual evidence manifest", "acceptance criteria"]
    },
    {
      "id": "tester-learning-loop",
      "owner": "crate-tester-insights",
      "playbook": ".codex/playbooks/crate-tester-intake.md",
      "standing_order": "SO-008",
      "modes": ["cross-tester synthesis", "product review"],
      "stop_gates": ["normalized records only", "do not expose identities or raw tester assets"],
      "evidence_outputs": ["recurring themes", "disagreement", "confidence", "next route"]
    },
    {
      "id": "launch-readiness-loop",
      "owner": "crate-launch-readiness",
      "playbook": ".codex/playbooks/crate-codex-loops.md",
      "standing_order": "SO-009",
      "modes": ["customer journey", "asset truth", "handoff to crate-ship"],
      "stop_gates": ["readiness does not authorize release", "crate-ship owns go/no-go synthesis"],
      "evidence_outputs": ["journey results", "asset/build mapping", "blockers", "owner"]
    },
    {
      "id": "launch-incident-rehearsal-loop",
      "owner": "crate-launch-incident-rehearsal",
      "playbook": ".codex/playbooks/crate-release-gate.md",
      "standing_order": "SO-009",
      "modes": ["tabletop", "gap report", "handoff"],
      "stop_gates": ["do not mutate live systems", "external communication requires separate approval"],
      "evidence_outputs": ["scenario", "detection path", "owner", "recovery gaps"]
    },
    {
      "id": "dependency-watch-loop",
      "owner": "crate-dependency-watch",
      "playbook": ".codex/playbooks/security-audit.md",
      "standing_order": "SO-010",
      "modes": ["collect read-only reports", "classify", "recommend"],
      "stop_gates": ["do not install, update, fix, dedupe, or mutate lockfiles", "network collection requires approval"],
      "evidence_outputs": ["runtime findings", "development findings", "upgrade proposal or monitor recommendation"]
    }
  ]
}
